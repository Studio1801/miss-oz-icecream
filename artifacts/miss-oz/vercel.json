{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app$"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/wholesale",
      "destination": "/wholesale/index.html"
    },
    {
      "source": "/events",
      "destination": "/events/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/dashboard.html",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?missozicecream\\.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?missozicecream\\.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/menu",
      "destination": "/#menu",
      "permanent": true
    },
    {
      "source": "/new-flavor",
      "destination": "/#new-flavor",
      "permanent": true
    }
  ]
}
