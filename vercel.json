{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/miss-oz build",
  "outputDirectory": "artifacts/miss-oz/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/events", "destination": "/events/index.html" },
    { "source": "/wholesale", "destination": "/wholesale/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/menu", "destination": "/index.html" },
    { "source": "/new-flavor", "destination": "/index.html" }
  ]
}
